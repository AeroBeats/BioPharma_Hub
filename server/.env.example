# BioPharma Hub backend configuration. Copy to .env and fill in.
# NEVER commit the real .env (it holds secrets).

# --- Database ---
# Option A (production, your server): full SQLAlchemy URL for PostgreSQL.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/biopharma_hub
#
# Option B: build the URL from parts (used when DATABASE_URL is empty).
DB_BACKEND=postgresql
PG_USER=biopharma
PG_PASSWORD=change-me
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=biopharma_hub
#
# Option C (local development only): DB_BACKEND=sqlite uses a file database.
# DB_BACKEND=sqlite
# SQLITE_PATH=./dev.db

# --- Auth ---
# Long random string. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# --- CORS ---
# Comma-separated origins allowed to call this API (the static frontend).
ALLOWED_ORIGINS=https://aerobeats.github.io